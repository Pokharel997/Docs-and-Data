{
  "manifest_version": 3,
  "name": "Data & Docs",
  "version": "1.0.0",
  "description": "Open CSV, Excel, Word, JSON, Markdown, PDF and video files and whole folders in browser tabs. Edit them in the Data & Docs app.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Data & Docs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "contextMenus",
    "webNavigation",
    "nativeMessaging",
    "downloads",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "116"
}